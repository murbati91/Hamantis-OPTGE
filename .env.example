# Copy to .env and fill in. Only VITE_-prefixed vars reach the client bundle.

# Clerk auth (REQUIRED) — Clerk → Configure → API Keys.
# Development = pk_test_… (works on any domain, no DNS). Production = pk_live_…
# (needs the Clerk Domains DNS records added to your domain first).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase opt-in cloud sync (optional) — Project → Settings → API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxx...

# NEVER put a Clerk SECRET key or a Supabase SERVICE_ROLE key in a VITE_ var —
# they would be bundled into the public client. Those belong server-side only.

# --- Backend-only: server/deck-refine.mjs (AI Deck Builder "Refine with Claude") ---
# This process is the ONLY thing that ever reads these — never VITE_-prefixed,
# never bundled into the browser. The frontend calls the same-origin
# /api/deck/refine route; it never talks to Anthropic directly.

# Anthropic API key used server-side to generate deck refinement critiques.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — model override (defaults to claude-haiku-4-5-20251001 in code).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional — local port the deck-refine proxy listens on (defaults to 8791).
# nginx reverse-proxies /api/ on the public domain to 127.0.0.1:$DECK_REFINE_PORT.
DECK_REFINE_PORT=8791
